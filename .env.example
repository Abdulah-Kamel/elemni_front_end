# Backend API base URL
API_URL=http://localhost:8001

# Public origin used by teacher and course images (for example, the Bunny CDN).
ASSETS_URL=http://localhost:8001

# Teacher dashboard origin (public; embedded at build time)
NEXT_PUBLIC_TEACHER_DASHBOARD_URL=https://elemni-dashboard.vercel.app

# Contact email displayed in footer
CONTACT_EMAIL=mero@elemni.com

# Contact form delivery via EmailJS (server-side only; never use NEXT_PUBLIC_).
# Find these in EmailJS: Email Services, Email Templates, and Account > API keys.
# Enable "Allow EmailJS API for non-browser applications" in the account settings.
# Configure the template recipient as {{to_email}} and Reply-To as {{reply_to}}.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
CONTACT_FORM_TO=mokhtarstory1@gmail.com
